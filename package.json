{
  "name": "milana",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "node scripts/configure.mjs && ng serve",
    "build": "node scripts/configure.mjs && ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "test:e2e": "node tests/browser-check.mjs",
    "test:catalog-api": "node tests/catalog-api-check.mjs",
    "test:admin-form": "node tests/admin-form-check.mjs",
    "test:motion": "node tests/product-motion-check.mjs",
    "preview:pages": "node scripts/serve-production.mjs",
    "import:photos": "node scripts/configure.mjs && node scripts/import-catalog-photos.mjs",
    "check:access": "node scripts/configure.mjs && node scripts/check-supabase-access.mjs"
  },
  "private": true,
  "packageManager": "pnpm@12.8.1",
  "dependencies": {
    "@angular/common": "22.2.1",
    "@angular/compiler": "22.2.1",
    "@angular/core": "22.2.1",
    "@angular/forms": "22.2.1",
    "@angular/platform-browser": "22.2.1",
    "@angular/router": "22.2.1",
    "@supabase/supabase-js": "^2.117.2",
    "animejs": "4.2.2",
    "rxjs": "7.8.2",
    "tslib": "2.8.1"
  },
  "devDependencies": {
    "@angular/build": "22.2.1",
    "@angular/cli": "22.2.1",
    "@angular/compiler-cli": "22.2.1",
    "@types/node": "22.19.17",
    "jsdom": "30.1.2",
    "playwright": "1.63.0",
    "prettier": "3.9.9",
    "typescript": "6.0.2",
    "vitest": "5.0.3"
  }
}
